{
  "name": "ta.js",
  "version": "2.1.0",
  "description": "Technical analysis library for JavaScript and Node.js — 153 stock, crypto and forex indicators (SMA, RSI, MACD, Bollinger Bands, ATR, ADX, SuperTrend). Zero dependencies, CommonJS + ESM + browser bundles.",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "test": "npm run verify-zero-deps && node --test 'test/*.test.js'",
    "benchmark": "node ./test/benchmark.js",
    "build": "node ./scripts/build.js",
    "verify-bundle": "node ./scripts/build.js --check",
    "verify-zero-deps": "node -e \"const p=require('./package.json'); const d=p.dependencies||{}; const n=Object.keys(d).length; if(n){console.error('runtime dependencies must stay empty for v2.0; found:',d); process.exit(1)} else {console.log('zero runtime deps: ok')}\""
  },
  "devDependencies": {
    "esbuild": "^0.24.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bitvested/ta.js.git"
  },
  "keywords": [
    "technical-analysis",
    "technical-indicators",
    "trading",
